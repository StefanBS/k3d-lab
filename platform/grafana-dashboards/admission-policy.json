{
  "annotations": {
    "list": []
  },
  "description": "What the Lab's admission policies (platform/kyverno-policies/) rejected and found, from Kyverno's metrics in Prometheus.",
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Admission",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Rejected, by policy",
      "description": "Objects an enforced policy rejected as they were applied. ArgoCD retries a rejected sync, so one bad object counts many times.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy_name, resource_namespace) (increase(kyverno_validating_policy_results_total{execution_cause=\"admission_request\", policy_validation_mode=\"Deny\", result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "{{policy_name}} in {{resource_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Admitted with a violation, by policy",
      "description": "Objects that broke an Audit policy and were admitted anyway. Each shows up in its namespace's PolicyReport.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy_name, resource_namespace) (increase(kyverno_validating_policy_results_total{execution_cause=\"admission_request\", policy_validation_mode=\"Audit\", result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "{{policy_name}} in {{resource_namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Admission review time (mean)",
      "description": "How long Kyverno takes to answer the API server, per object.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kyverno_admission_review_duration_seconds_sum[$__rate_interval])) / sum(rate(kyverno_admission_review_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4
    },
    {
      "type": "row",
      "title": "Background scans: what the PolicyReports hold",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [],
      "id": 5
    },
    {
      "type": "table",
      "title": "Violations found by background scans",
      "description": "Each failing result of the background scans of Kyverno's reports controller, counted since it started, for the policies, namespaces and kinds seen in this time range: the same results as the PolicyReports. It scans every object every hour, and again whenever it changes. kubectl get policyreports -A shows what fails now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (policy_name, policy_validation_mode, resource_namespace, resource_kind) (last_over_time(kyverno_validating_policy_results_total{execution_cause=\"background_scan\", result!=\"pass\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "policy_name": "Policy",
              "policy_validation_mode": "Mode",
              "resource_namespace": "Namespace",
              "resource_kind": "Kind",
              "Value": "Results"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Background scan results",
      "description": "Every result of the background scans, by outcome, since the reports controller started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "expr": "sum by (result) (last_over_time(kyverno_validating_policy_results_total{execution_cause=\"background_scan\"}[$__range]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 7
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "k3d-lab"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Admission policy",
  "uid": "admission-policy",
  "version": 1
}
