{
  "uid": "gpu-comfyui",
  "title": "GPU and ComfyUI",
  "description": "The GPU Node's GPU, from node-exporter's drm and hwmon metrics, and ComfyUI's jobs, from its logs in Loki.",
  "tags": [
    "k3d-lab",
    "gpu"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "GPU Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_node_status_allocatable{resource=\"amd_com_gpu\"}, node)",
          "refId": "node"
        },
        "definition": "label_values(kube_node_status_allocatable{resource=\"amd_com_gpu\"}, node)",
        "refresh": 2,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "ComfyUI jobs",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{namespace=\"comfyui\", container=\"comfyui\"} |= \"Prompt executed in\"",
        "textFormat": "{{__line__}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "GPU",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "GPU busy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "node_drm_gpu_busy_percent{node=\"$node\"} / 100",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "VRAM used",
      "description": "ComfyUI is started with --reserve-vram 3, so it leaves about 3 GB free on purpose.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "node_drm_memory_vram_used_bytes{node=\"$node\"} / node_drm_memory_vram_size_bytes{node=\"$node\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Junction temperature",
      "description": "The hottest spot on the GPU die. The card throttles at 110 °C.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "node_hwmon_temp_celsius{node=\"$node\", sensor=\"temp2\"} * on (node, chip) group_left () node_hwmon_chip_names{chip_name=\"amdgpu\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory temperature",
      "description": "The VRAM's temperature. The card throttles at 108 °C.",
