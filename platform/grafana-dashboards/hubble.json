{
  "uid": "hubble",
  "title": "Hubble network",
  "description": "What Cilium forwarded and dropped, and why, from Hubble's flow metrics in Prometheus.",
  "tags": [
    "k3d-lab"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Drops",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Drops by reason",
      "description": "Packets Cilium dropped, by why. POLICY_DENIED is a network policy at work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (reason) (rate(hubble_drop_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drops by source namespace",
      "description": "Packets dropped, by the namespace of the pod that sent them: what a policy stopped leaving.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (source_namespace, reason) (rate(hubble_drop_total[$__rate_interval])), \"source_namespace\", \"(no pod)\", \"source_namespace\", \"\")",
          "legendFormat": "{{source_namespace}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drops by destination namespace",
      "description": "Packets dropped, by the namespace of the pod they were for: what a policy stopped arriving.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (destination_namespace, reason) (rate(hubble_drop_total[$__rate_interval])), \"destination_namespace\", \"(no pod)\", \"destination_namespace\", \"\")",
          "legendFormat": "{{destination_namespace}} {{reason}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Flows",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Flows by verdict",
      "description": "Every flow Hubble saw, by what Cilium did with it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (verdict) (rate(hubble_flows_processed_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Flows by destination namespace",
      "description": "Forwarded flows, by the namespace of the pod they were for.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (destination_namespace) (rate(hubble_flows_processed_total{verdict=\"FORWARDED\"}[$__rate_interval])), \"destination_namespace\", \"(no pod)\", \"destination_namespace\", \"\")",
          "legendFormat": "{{destination_namespace}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DNS queries by source namespace",
      "description": "DNS queries that a policy's DNS rule sends through Cilium's DNS proxy, by the namespace that asked.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (source_namespace, rcode) (rate(hubble_dns_queries_total[$__rate_interval])), \"source_namespace\", \"(no pod)\", \"source_namespace\", \"\")",
          "legendFormat": "{{source_namespace}} {{rcode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by destination namespace and status",
      "description": "HTTP requests that a policy's L7 rule sends through Cilium's proxy, by the namespace of the pod they were for.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(sum by (destination_namespace, status) (rate(hubble_http_requests_total[$__rate_interval])), \"destination_namespace\", \"(no pod)\", \"destination_namespace\", \"\")",
          "legendFormat": "{{destination_namespace}} {{status}}"
        }
      ]
    }
  ]
}
