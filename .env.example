# Copy to .env (never committed) and fill in. Machine-specific values stay out of Git.
# Only the GPU Node recipes need these; the rest of the Lab runs without a .env.

# The Host's LAN IP. Needs a DHCP reservation: the GPU Node routes the Lab's subnet via it (ADR 0002).
HOST_LAN_IP=192.0.2.10
# The GPU Node's LAN IP.
GPU_NODE_IP=192.0.2.20
# SSH destination for the GPU Node: an ~/.ssh/config alias, or k3dlab@<ip>.
GPU_NODE_SSH=k3dlab@192.0.2.20
