# Copy to .env (never committed) and fill in. Machine-specific values stay out of Git.
# The GPU Node recipes need the values below; the rest of the Lab runs without a .env,
# and LAB_WITHOUT, at the end, is optional.

# The Host's LAN IP. Needs a DHCP reservation: the GPU Node routes the Lab's subnet via it (ADR 0002).
# `just host wizard` walks you through the reservation and fills this in.
HOST_LAN_IP=192.0.2.10
# The GPU Node's LAN IP.
GPU_NODE_IP=192.0.2.20
# SSH destination for the GPU Node: an ~/.ssh/config alias, or k3dlab@<ip>.
GPU_NODE_SSH=k3dlab@192.0.2.20

# The Features `just up` builds a Lab without, comma-separated, such as admission-policy:
# the sets of components in gitops/values.yaml's features. `just up --without` replaces it,
# and `--without none` builds every Feature. Unset, a Lab has every Feature.
# LAB_WITHOUT=admission-policy
