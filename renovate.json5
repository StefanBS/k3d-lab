// Renovate keeps every pinned version current, one reviewed PR at a time: it never
// merges anything itself. Each PR runs `just lint`, like any other.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  automerge: false,
  // Plain manifests that pin an image. The kustomize, mise and github-actions managers
  // find the rest of the images, the tools, the actions and CI's mise by themselves.
  kubernetes: {
    managerFilePatterns: ['/^workloads/.+\\.yaml$/', '/^verify/lib/.+\\.yaml$/'],
  },
  customManagers: [
    {
      description: "A component's chart (platform/ and workloads/)",
      customType: 'regex',
      managerFilePatterns: ['/^(platform|workloads)/[^/]+/component\\.yaml$/'],
      matchStrings: ['chart: (?<depName>\\S+)\\nrepoURL: (?<registryUrl>\\S+)\\nversion: (?<currentValue>\\S+)'],
      datasourceTemplate: 'helm',
    },
    {
      description: "The k3s image, and so the Lab's Kubernetes version",
      customType: 'regex',
      managerFilePatterns: ['/^k3d/cluster\\.yaml$/'],
      matchStrings: ['image: (?<depName>rancher/k3s):(?<currentValue>\\S+)'],
      datasourceTemplate: 'docker',
      // v1.36.4-k3s1: a new patch of Kubernetes, or a new k3s build of the same one.
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$',
    },
    {
      description: 'A GitHub release asset, pinned by its URL',
      customType: 'regex',
      managerFilePatterns: ['/^platform/.+\\.yaml$/'],
      matchStrings: ['https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/'],
      datasourceTemplate: 'github-releases',
    },
    {
      description: 'A version on the line below a `# renovate: datasource=... depName=...` comment',
      customType: 'regex',
      managerFilePatterns: ['/^scripts/.+\\.sh$/', '/^platform/.+\\.yaml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[^\\n]*[:=]\\s*"?(?<currentValue>[^\\s"]+?)"?\\s*\\n',
      ],
    },
  ],
  // Related updates come in one PR, so they're reviewed (and run) together. Within a
  // group, a major update still gets its own PR.
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: ['github-actions'],
    },
    {
      // The mise version CI installs the tools with (the github-actions manager finds it).
      groupName: 'Lab tools',
      matchManagers: ['mise'],
    },
    {
      groupName: 'Lab tools',
      matchDepNames: ['jdx/mise'],
    },
    {
      // kubectl matches the Lab's Kubernetes version (mise.toml).
      groupName: 'Kubernetes',
      matchDepNames: ['rancher/k3s', 'kubectl'],
    },
    {
      // The Gateway API CRDs are at the version Cilium supports.
      groupName: 'Cilium and Gateway API',
      matchDepNames: ['cilium', 'kubernetes-sigs/gateway-api'],
    },
    {
      groupName: 'Argo',
      matchDepNames: ['argo-cd', 'argo-rollouts', 'argoproj-labs/rollouts-plugin-trafficrouter-gatewayapi'],
    },
    {
      groupName: 'Observability',
      matchDepNames: [
        'alloy',
        'grafana',
        'loki',
        'tempo',
        'prometheus',
        'kube-state-metrics',
        'prometheus-node-exporter',
        'prometheus-operator-crds',
      ],
    },
    {
      groupName: 'GPU',
      matchDepNames: ['amd-gpu', 'docker.io/rocm/k8s-device-plugin', 'docker.io/ollama/ollama'],
    },
    {
      groupName: 'Demo and probe images',
      matchDepNames: ['ghcr.io/stefanprodan/podinfo', 'curlimages/curl', 'traefik/whoami', 'busybox'],
    },
    {
      matchDepNames: ['argoproj-labs/rollouts-plugin-trafficrouter-gatewayapi'],
      prBodyNotes: [
        "**Before merging:** set the plugin's `sha256` in `platform/argo-rollouts/values.yaml` to the new asset's checksum from its GitHub release. The controller refuses the plugin otherwise, and `just lint` doesn't check it.",
      ],
    },
    {
      matchDepNames: ['ghcr.io/openbao/openbao'],
      prBodyNotes: [
        "**Before merging:** check OpenBao's release notes for storage or seal changes. The update reaches the Host only when you re-run `just host-setup`, which restarts the Secret Store on the new image.",
      ],
    },
  ],
}
